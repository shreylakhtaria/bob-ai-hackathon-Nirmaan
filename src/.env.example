# ============ Grid Risk Command Center - environment ============
# Copy to .env and adjust. All values have safe defaults; nothing is required.

# --- Environment ---
# "development" | "production". Production refuses to boot without a real
# AUTH_SECRET_KEY, and marks cookies Secure (HTTPS-only).
ENVIRONMENT=development

# --- Auth / security (REQUIRED in production) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# COOKIE_SECURE defaults to true in production, false in development.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Emails promoted to admin on signup (comma-separated). Everyone else is an operator.
# ADMIN_EMAILS=lead.dispatcher@example.com

# --- CORS ---
# The browser origin of the Next.js console. Wildcards are not valid with cookies.
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://grid.example.com

# --- Rate limiting (credential endpoints only) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_REFRESH=30/minute

# --- Data / simulation ---
SEED=42
N_ASSETS=220
HISTORY_DAYS=21
PREDICTION_HORIZON_HOURS=72
HERO_TARGET_DEG=0.60          # demo hero (T-1024) severity, 0..1

# --- Database (default: local SQLite file) ---
# DB_PATH=./data/grid.db
# DATABASE_URL=sqlite:///./data/grid.db     # switch to postgresql://... for Postgres

# --- Crew optimiser ---
CREW_SPEED_KMPH=45

# --- Public app URL (used in Telegram messages so an operator can jump back in) ---
PUBLIC_APP_URL=http://localhost:3000

# --- Telegram live alert notifications (optional, free) ---
# Off by default. The app starts and runs normally with none of this set.
# Setup: README -> "Telegram live alerts". Never commit a real token.
TELEGRAM_ENABLED=false
# From @BotFather. This is a bearer credential for the whole bot — keep it here,
# never in code, never in the frontend, never in a commit.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (message the bot first, then read it from getUpdates).
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
# Only these priorities are pushed. MEDIUM/LOW stay in the dashboard.
TELEGRAM_NOTIFY_PRIORITIES=CRITICAL,HIGH
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_SECONDS=1
# The alert pipeline recreates every alert row on each run, so the same real
# condition would notify repeatedly without this content-keyed window.
TELEGRAM_DEDUP_WINDOW_MINUTES=30
TELEGRAM_PARSE_MODE=HTML

# --- Optional LLM for the copilot (leave blank for grounded local mode) ---
# Providers are tried in this order: IBM Bob -> IBM watsonx.ai -> Nebius -> OpenAI -> Azure.

# -- IBM Bob (hackathon coding-agent CLI; checked first) --
# Requires the `bob` CLI on PATH: https://bob.ibm.com/docs/shell/getting-started/install-and-setup
# BOB_API_KEY=bob_prod_...

# -- IBM watsonx.ai (native chat + tool calling) --
# WATSONX_API_KEY=...            # IBM Cloud IAM API key
# WATSONX_PROJECT_ID=...         # watsonx.ai project id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
# WATSONX_VERSION=2024-10-07

# -- Nebius (GPT OSS 120B) --
# NEBIUS_API_KEY=...
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL=openai/gpt-oss-120b

# -- plain OpenAI --
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# -- Azure OpenAI --
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
