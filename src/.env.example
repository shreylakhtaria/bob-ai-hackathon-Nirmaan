# ============ Grid Risk Command Center - environment ============
# Copy to .env and adjust. All values have safe defaults; nothing is required.

# --- Data / simulation ---
SEED=42
N_ASSETS=220
HISTORY_DAYS=21
PREDICTION_HORIZON_HOURS=72
HERO_TARGET_DEG=0.60          # demo hero (T-1024) severity, 0..1

# --- Database (default: local SQLite file) ---
# DB_PATH=./data/grid.db
# DATABASE_URL=sqlite:///./data/grid.db     # switch to postgresql://... for Postgres

# --- Crew optimiser ---
CREW_SPEED_KMPH=45

# --- Optional LLM for the copilot (leave blank for grounded local mode) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# --- or Azure OpenAI ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
